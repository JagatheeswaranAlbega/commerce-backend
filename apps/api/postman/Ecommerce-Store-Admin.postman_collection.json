{
  "info": {
    "name": "Ecommerce Store Admin",
    "description": "Store Admin APIs under /api/v1/auth and /api/v1/admin (storeId from JWT)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8787/api/v1"
    },
    {
      "key": "jwt_token",
      "value": ""
    },
    {
      "key": "product_id",
      "value": ""
    },
    {
      "key": "variant_id",
      "value": ""
    },
    {
      "key": "order_id",
      "value": ""
    },
    {
      "key": "category_id",
      "value": ""
    },
    {
      "key": "collection_id",
      "value": ""
    },
    {
      "key": "discount_id",
      "value": ""
    },
    {
      "key": "customer_id",
      "value": ""
    },
    {
      "key": "media_id",
      "value": ""
    },
    {
      "key": "key_id",
      "value": ""
    },
    {
      "key": "global_product_id",
      "value": ""
