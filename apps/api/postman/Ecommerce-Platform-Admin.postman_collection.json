{
  "info": {
    "name": "Ecommerce Platform Admin",
    "description": "Platform Super Admin APIs under /api/v1/auth and /api/v1/platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8787/api/v1"
    },
    {
      "key": "jwt_token",
      "value": ""
    },
    {
      "key": "store_id",
      "value": ""
    },
    {
      "key": "product_id",
      "value": ""
    },
    {
      "key": "order_id",
      "value": ""
    },
    {
      "key": "key_id",
      "value": ""
    },
    {
      "key": "customer_id",
      "value": ""
    },
    {
      "key": "global_product_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.accessToken) {",
                  "  pm.collectionVariables.set('jwt_token', json.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"platform@admin.com\",\n  \"password\": \"Platform@123\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/auth/me"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Platform@123\",\n  \"newPassword\": \"Platform@123\"\n}"
            },
            "url": "{{base_url}}/auth/change-password"
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Platform",
      "item": [
        {
          "name": "Metrics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/platform/metrics"
          }
        },
        {
          "name": "List Stores",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/platform/stores"
          }
        },
        {
          "name": "Create Store",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.store?.id) pm.collectionVariables.set('store_id', json.data.store.id);",
                  "const publishable = json?.data?.keys?.publishableKey;",
                  "if (publishable) {",
                  "  const key = String(publishable).replace(/[\\r\\n\\t]/g, '').trim();",
                  "  pm.collectionVariables.set('publishable_key', key);",
                  "  console.log('Saved publishable_key (copy this one line into Storefront env):', key);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Store\",\n  \"slug\": \"new-store\"\n}"
            },
            "url": "{{base_url}}/platform/stores"
          }
        },
        {
          "name": "Get Store",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/platform/stores/{{store_id}}"
          }
        },
        {
          "name": "Update Store",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Store\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{base_url}}/platform/stores/{{store_id}}"
          }
        },
        {
          "name": "Deactivate Store",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"INACTIVE\"\n}"
            },
            "url": "{{base_url}}/platform/stores/{{store_id}}"
          }
        },
        {
          "name": "Delete Store",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/platform/stores/{{store_id}}"
          }
        },
        {
          "name": "List Store Admins",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/platform/stores/{{store_id}}/admins"
          }
        },
        {
          "name": "Create Store Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"second-admin@store.local\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": "{{base_url}}/platform/stores/{{store_id}}/admins"
          }
        },
        {
          "name": "Update Store Admin",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true\n}"
            },
            "url": "{{base_url}}/platform/stores/{{store_id}}/admins/{{user_id}}"
          }
        },
        {
          "name": "Delete Store Admin",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/platform/stores/{{store_id}}/admins/{{user_id}}"
          }
        },
        {
          "name": "List Keys",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/platform/stores/{{store_id}}/keys"
          }
        },
        {
          "name": "Create Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.id) pm.collectionVariables.set('key_id', json.data.id);",
                  "const rawKey = json?.data?.rawKey;",
                  "if (rawKey) {",
                  "  const key = String(rawKey).replace(/[\\r\\n\\t]/g, '').trim();",
                  "  pm.collectionVariables.set('publishable_key', key);",
                  "  console.log('Saved publishable_key (copy this one line into Storefront env):', key);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"PUBLISHABLE\"\n}"
            },
            "url": "{{base_url}}/platform/stores/{{store_id}}/keys"
          }
        },
        {
          "name": "Delete Key",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/platform/stores/{{store_id}}/keys/{{key_id}}"
          }
        },
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/platform/products"
          }
        },
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/platform/orders?page=1&pageSize=20&storeId={{store_id}}"
          }
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/platform/orders/{{order_id}}"
          }
        },
        {
          "name": "List Customers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/platform/customers?page=1&pageSize=20&storeId={{store_id}}"
          }
        },
        {
          "name": "Get Customer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/platform/customers/{{customer_id}}"
          }
        },
        {
          "name": "Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/platform/audit-logs?page=1&pageSize=20"
          }
        },
        {
          "name": "Get Settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/platform/settings"
          }
        },
        {
          "name": "Update Settings",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"platformName\": \"Commerce Console\",\n  \"supportEmail\": \"support@example.com\"\n}"
            },
            "url": "{{base_url}}/platform/settings"
          }
        }
      ]
    },
    {
      "name": "Global Catalog",
      "item": [
        {
          "name": "List global categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/platform/global-categories"
          }
        },
        {
          "name": "Create global category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fashion\",\n  \"slug\": \"fashion\"\n}"
            },
            "url": "{{base_url}}/platform/global-categories"
          }
        },
        {
          "name": "List global products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/platform/global-products?page=1&pageSize=20"
          }
        },
        {
          "name": "Create global product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Everyday Cotton Tee\",\n  \"handle\": \"everyday-cotton-tee\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{base_url}}/platform/global-products"
          }
        },
        {
          "name": "Get global product",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{base_url}}/platform/global-products/{{global_product_id}}"
          }
        }
      ]
    }
  ]
}
