ENVIRONMENT=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_multi_tenancy"
# Used by `wrangler dev` Hyperdrive binding (overrides wrangler.jsonc localConnectionString).
# Must match DATABASE_URL so Worker queries use the same DB as migrate/seed.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://postgres:postgres@localhost:5432/ecommerce_multi_tenancy"
JWT_SECRET=replace-with-a-development-secret-at-least-32-chars
FRONTEND_URL=http://localhost:3001

# Optional. After checkout, send "order placed" mail via ZeptoMail. Leave unset to skip.
# Do not commit a real send-mail token.
# ZEPTOMAIL_TOKEN=
# ZEPTOMAIL_FROM=orders@yourdomain.com
# ZEPTOMAIL_FROM_NAME=Orders
# India accounts often use https://api.zeptomail.in/v1.1/email
# ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email

# Development seed only. Do not use these values in production.
SEED_STORE_PASSWORD=Admin@123
SEED_PLATFORM_ADMIN_EMAIL=platform@admin.com
SEED_PLATFORM_ADMIN_PASSWORD=Platform@123
# Back-compat aliases
SEED_SUPER_ADMIN_EMAIL=platform@admin.com
SEED_SUPER_ADMIN_PASSWORD=Platform@123
DEFAULT_CURRENCY=INR
