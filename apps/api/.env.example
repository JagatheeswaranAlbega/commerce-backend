ENVIRONMENT=development
# Local Postgres OR Neon. For Neon + Cloudflare Hyperdrive, use the DIRECT
# (non-pooler) connection string from the Neon dashboard — Hyperdrive pools for you.
DATABASE_URL="postgresql://postgres:admin@localhost:5432/ecommerce_multi_tenancy"
# Used by `wrangler dev` Hyperdrive binding (overrides wrangler.jsonc localConnectionString).
# Must match DATABASE_URL so Worker queries use the same DB as migrate/seed.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://postgres:admin@localhost:5432/ecommerce_multi_tenancy"
JWT_SECRET=replace-with-a-development-secret-at-least-32-chars
FRONTEND_URL=http://localhost:3001

# Development seed only. Do not use these values in production.
SEED_STORE_PASSWORD=StoreAdmin@123
SEED_PLATFORM_ADMIN_EMAIL=platform@local.dev
SEED_PLATFORM_ADMIN_PASSWORD=Platform@123
# Back-compat aliases
SEED_SUPER_ADMIN_EMAIL=platform@local.dev
SEED_SUPER_ADMIN_PASSWORD=Platform@123
DEFAULT_CURRENCY=INR
